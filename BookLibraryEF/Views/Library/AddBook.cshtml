@model BookLibraryEF.Models.Book

@{
    ViewData["Title"] = "Add New Book";
}

<div class="container mt-4">
    <h2>Add Book</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="AddBook" method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Book Name</label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="AuthorID" class="form-label">Author</label>
                    <select asp-for="AuthorID" class="form-select searchable-select" required>
                        <option value="">Select Author</option>
                        @foreach (var author in ViewBag.Authors)
                        {
                            <option value="@author.AuthorID">@author.AuthorName</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="ReleaseYear" class="form-label">Release Year</label>
                    <input asp-for="ReleaseYear" type="number" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label">Image Url</label>
                    <input asp-for="ImageUrl" class="form-control" required />
                </div>
                <button type="submit" class="btn" style="background-color: lightpink; border-color: lightpink; color: black; font-weight: 500;">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>